{
  "buildCommand": "bun run scripts/vercel-build.ts && next build",
  "crons": [
    {
      "path": "/api/cron/escalate",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 4 * * *"
    }
  ],
  "regions": ["bom1"],
  "functions": {
    "src/app/api/bot/send/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/route.ts": {
      "maxDuration": 30
    }
  }
}
