# CityHelp — Environment Variables

# ── Database ──────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=file:/home/z/my-project/db/custom.db
# Production (Neon Postgres):
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# When switching to Postgres, also change provider in prisma/schema.prisma to "postgresql"

# ── Security ──────────────────────────────────────────────
# Master key for encrypting third-party API keys at rest (AES-256-GCM)
# Generate: openssl rand -base64 32
CITYHELP_MASTER_KEY=change-me-to-a-32-byte-random-string-xxxxx

# Session signing secret (HMAC)
# Generate: openssl rand -base64 32
CITYHELP_SESSION_SECRET=change-me-to-another-random-string-xxxxx

# ── Super Admin (used by idempotent seed) ────────────────
SUPER_ADMIN_EMAIL=super@cityhelp.app
SUPER_ADMIN_PASSWORD=change-this-in-production

# ── WhatsApp Cloud API (PER-TENANT — configured in dashboard) ──
# Only the API version is global:
WHATSAPP_API_VERSION=v21.0
# Optional fallback verify token for webhook handshake
WHATSAPP_VERIFY_TOKEN=cityhelp_global_fallback_verify_token

# ── Storage (Cloudinary default, R2 alternative) ────────
# Default: Cloudinary (free 25GB tier)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alternative: Cloudflare R2 (zero egress, S3-compatible)
# To enable: set STORAGE_PROVIDER=r2 and install @aws-sdk/client-s3
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=cityhelp-media
# R2_PUBLIC_URL=https://media.cityhelp.app

# ── AI (BYOK — tenants bring their own keys) ─────────────
# Optional: z-ai-web-dev-sdk is bundled for platform fallback

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=CityHelp <notifications@cityhelp.app>

# ── Billing (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# ── Web Push (VAPID) ─────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:notifications@cityhelp.app

# ── Cron (Vercel Cron auth) ──────────────────────────────
CRON_SECRET=your-cron-secret

# ── App URL ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://cityhelp.app

# ── Caching (Upstash Redis — optional, falls back to no-cache) ──
# Free tier: 10k commands/day, 256MB
# Get keys at: https://console.upstash.com → Create Database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error Tracking (Sentry) — optional ───────────────────
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# ── WebSocket Service (Cloudflare Workers) ───────────────
# The Worker is auto-deployed during Vercel build (scripts/vercel-build.ts).
# Just set these env vars in Vercel and the Worker deploys on every push.
#
# Required for auto-deploy:
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token  # Needs "Workers Scripts:Edit" permission
#
# Shared secret for broadcast auth (must match on both sides):
WS_SERVICE_URL=https://cityhelp-realtime.your-account.workers.dev
BROADCAST_SECRET=cityhelp-dev-broadcast-secret
#
# Manual deploy (if auto-deploy is not configured):
#   cd mini-services/realtime
#   npx wrangler login
#   npx wrangler secret put BROADCAST_SECRET
#   npx wrangler deploy
